# Frontend Environment Variables

# API Configuration
VITE_API_URL=https://jauntsolutions.net

# Backend database used by Prisma
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# reCAPTCHA Configuration
# Get your sitekey from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Backend reCAPTCHA secret from the same Google reCAPTCHA project
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Resend email configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Jaunt Solutions <hello@your-verified-domain.com>
ADMIN_EMAIL=admin@example.com
